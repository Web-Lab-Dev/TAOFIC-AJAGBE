rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function profile() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function hasProfile() {
      return signedIn() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        profile().active == true &&
        profile().storeId is string;
    }

    function isStoreMember(storeId) {
      return hasProfile() && profile().storeId == storeId;
    }

    function validClient(data) {
      return data.keys().hasAll(['nom', 'prenom', 'registeredStoreId', 'registeredStoreName']) &&
             data.nom is string && data.nom.size() >= 2 && data.nom.size() <= 50 &&
             data.prenom is string && data.prenom.size() >= 2 && data.prenom.size() <= 50 &&
             data.registeredStoreId is string &&
             data.registeredStoreName is string &&
             (!data.keys().hasAny(['numeroPersonnel']) ||
              data.numeroPersonnel == '' ||
              data.numeroPersonnel.matches('^[0-9+\\-\\s()/]{8,120}$'));
    }

    function validTransaction(data) {
      return data.keys().hasAll(['type', 'montant', 'clientId']) &&
             data.type in ['Dépôt', 'Depot', 'Retrait', 'Crédit', 'Credit', 'DÃ©pÃ´t', 'CrÃ©dit'] &&
             data.montant is number && data.montant > 0 && data.montant <= 100000000 &&
             data.clientId is string && data.clientId.size() > 0;
    }

    function validStoreScopedTransaction(data, storeId) {
      return validTransaction(data) &&
        (!data.keys().hasAny(['storeId']) || data.storeId == storeId);
    }

    function validStatus(status) {
      return status in [
        'Non Terminées',
        'Non Terminees',
        'Non TerminÃ©es',
        'Validée',
        'Validee',
        'ValidÃ©e',
        'Remboursée',
        'Remboursee',
        'RemboursÃ©e',
        'Annulée',
        'Annulee',
        'AnnulÃ©e'
      ] ||
             status.matches('^(Payé|Remboursé|Encaissé) par .+$');
    }

    function isPendingStatus(status) {
      return status in ['Non Terminées', 'Non Terminees', 'Non TerminÃ©es'];
    }

    match /stores/{storeId} {
      allow read: if isStoreMember(storeId);
      allow create: if signedIn() &&
        request.resource.data.adminUid == request.auth.uid &&
        request.resource.data.active == true &&
        request.resource.data.name is string &&
        request.resource.data.name.size() >= 2;
      allow update, delete: if false;
    }

    match /users/{userId} {
      allow read: if signedIn() && request.auth.uid == userId;
      allow read: if hasProfile() && profile().storeId == resource.data.storeId;

      allow update: if hasProfile() &&
        request.auth.uid == userId &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lastLogin']);

      allow create: if signedIn() &&
        request.auth.uid == userId &&
        request.resource.data.role == 'store_admin' &&
        request.resource.data.active == true &&
        request.resource.data.storeId is string &&
        request.resource.data.storeName is string &&
        getAfter(/databases/$(database)/documents/stores/$(request.resource.data.storeId)).data.adminUid == request.auth.uid;

      allow delete: if false;
    }

    match /globalClients/{clientId} {
      allow read: if hasProfile();

      allow create: if hasProfile() &&
        validClient(request.resource.data) &&
        request.resource.data.registeredStoreId == profile().storeId;

      allow update: if hasProfile() &&
        resource.data.registeredStoreId is string &&
        resource.data.registeredStoreId == profile().storeId &&
        request.resource.data.registeredStoreId == resource.data.registeredStoreId &&
        validClient(request.resource.data);

      allow delete: if hasProfile() &&
        resource.data.registeredStoreId is string &&
        resource.data.registeredStoreId == profile().storeId;
    }

    match /clients/{storeId} {
      allow read: if isStoreMember(storeId);
      allow write: if false;

      match /drafts/{draftId} {
        allow read: if isStoreMember(storeId);
        allow create: if isStoreMember(storeId) &&
          validStoreScopedTransaction(request.resource.data, storeId) &&
          isPendingStatus(request.resource.data.statut);
        allow update: if isStoreMember(storeId) &&
          validStoreScopedTransaction(request.resource.data, storeId);
        allow delete: if isStoreMember(storeId);
      }

      match /history/{historyId} {
        allow read: if isStoreMember(storeId);
        allow create: if isStoreMember(storeId) &&
          validStoreScopedTransaction(request.resource.data, storeId) &&
          validStatus(request.resource.data.statut) &&
          !isPendingStatus(request.resource.data.statut);
        allow update: if isStoreMember(storeId) &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['statut', 'updatedAt', 'notes']) &&
          validStatus(request.resource.data.statut);
        allow delete: if isStoreMember(storeId);
      }

      match /networkBalances/{balanceId} {
        allow read: if isStoreMember(storeId);
        allow create, update: if isStoreMember(storeId) &&
          balanceId == 'current' &&
          request.resource.data.balances is map;
        allow delete: if false;
      }

      match /sessions/{sessionId} {
        allow read, write: if isStoreMember(storeId);
      }

      match /auditLogs/{logId} {
        allow read: if isStoreMember(storeId);
        allow write: if false;
      }
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
